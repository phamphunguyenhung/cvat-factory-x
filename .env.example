# Cau hinh cho release_control (Data Release Control Tower). KHONG commit file nay.
# CVAT: profile local doc CVAT_HOST / CVAT_PAT / CVAT_ORG (cvat_tools.core.client.Cvat.from_env)
CVAT_HOST=https://cvat.edufun.ai
CVAT_ORG=cohort-5a
CVAT_PAT=
CVAT_EDUFUN_PAT=
# Token tu a48 (instance chua xac dinh; release_control KHONG dung bien nay)
CVAT_A48_TOKEN=
# Tuy chon: de trong = auto-discover (config.py)
CVAT_RELEASE_PROJECT_ROOT=
CVAT_RELEASE_DAY10_DATA_SOURCE=
CVAT_DATA_DIR=
# Chi doc (config.py chua doc bien nay, them theo yeu cau)
RC_READ_ONLY=1
RC_DEMO_NAMESPACE=release_control_demo
